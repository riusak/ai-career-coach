# ForPro AI — variables d'environnement
# Copier ce fichier vers `.env.local` puis renseigner les valeurs.
# (.env.local est gitigné : ne JAMAIS committer de secrets.)

# ---------------------------------------------------------------------------
# Supabase (obligatoire) — Dashboard → Settings → API
# ---------------------------------------------------------------------------
# URL racine de l'API du projet (PAS l'URL REST : /rest/v1 est ajouté par le SDK).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clé publique (anon) — inline dans le bundle client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service-role : BYPASSE la RLS — serveur uniquement (admin/actions),
# ne JAMAIS l'exposer au client ni la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Gemini / LLM — analyse de CV (obligatoire en production)
# ---------------------------------------------------------------------------
# Clé API Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optionnel — défaut : gemini-3.5-flash-lite (fallback chaîne : gemini-3.6-flash).
# ⚠️ Les modèles 2.0/2.5 sont décommissionnés (404) ; ne pas revenir en arrière.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Quick Test (optionnels)
# ---------------------------------------------------------------------------
# Secret HMAC servant à anonymiser les IP (RGPD). Générer : openssl rand -hex 32
IP_HASH_SECRET=
# Nombre maximum de tests rapides par IP / 24 h (défaut : 30).
QUICK_TEST_RATE_LIMIT=30

# ---------------------------------------------------------------------------
# Scripts ops (optionnels — uniquement utilisés par scripts/)
# ---------------------------------------------------------------------------
# Test SMTP Supabase : scripts/test-smtp.mjs (Brevo ou autre).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
# Management API Supabase : scripts/update-supabase-smtp.mjs, seed-admin.mjs.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
